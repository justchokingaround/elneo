;;; home-test.el --- home page and hidden spaces -*- lexical-binding: t; -*-

(require 'elneo-home)

(defvar mx-failures 0)
(defun mx-check (label got want)
  (if (equal got want)
      (message "ok   %s" label)
    (setq mx-failures (1+ mx-failures))
    (message "FAIL %s\n  got:  %S\n  want: %S" label got want)))

(let* ((tmp (make-temp-file "elneo-home" t))
       (elneo-hidden-spaces-file (expand-file-name "hidden.el" tmp))
       (elneo-hidden-spaces 'unloaded)
       (elneo-accounts '(("default" :user-id "@me:matrix.org")
                         ("local" :user-id "@me:local")))
       (elneo--rooms (make-hash-table :test 'equal)))
  (cl-letf (((symbol-function 'elneo--accounts-load) #'ignore)
            ((symbol-function 'elneo-server-live-p) (lambda (_) t)))
    (dolist (r '(("local" "!discord" "Discord" :space t :space-children ("!guild" "!dm"))
                 ("local" "!guild" "Guild" :space t :space-children ("!chan" "!guild"))
                 ("local" "!chan" "general" :unread 4)
                 ("local" "!dm" "friend" :direct t :unread 1)
                 ("local" "!plain" "plain room")
                 ("default" "!emacs" "emacs" :unread 2)))
      (puthash (cons (nth 0 r) (nth 1 r))
               (append (list :profile (nth 0 r) :room-id (nth 1 r)
                             :display-name (nth 2 r) :room-state "joined")
                       (nthcdr 3 r))
               elneo--rooms))
    (mx-check "subtree follows nesting, cuts the cycle"
              (sort (elneo-space-subtree "local" "!discord") #'string<)
              '("!chan" "!discord" "!dm" "!guild"))
    (elneo-home)
    (with-current-buffer "*Matrix Home*"
      (let ((text (buffer-string)))
        (mx-check "folded space sums its subtree" (and (string-match-p "Discord 5" text) t) t)
        (mx-check "folded space hides children" (string-match-p "general" text) nil)
        (mx-check "loose room listed" (and (string-match-p "plain room" text) t) t))
      (goto-char (point-min))
      (search-forward "Discord")
      (elneo-home-toggle-fold)
      (mx-check "unfold shows the sub-space" (and (string-match-p "Guild" (buffer-string)) t) t)
      (search-forward "Discord")
      (elneo-home-hide)
      (elneo-home-refresh)
      (mx-check "hidden list persisted"
                (with-temp-buffer (insert-file-contents elneo-hidden-spaces-file)
                                  (read (current-buffer)))
                '(("local" . "!discord")))
      (mx-check "hidden rooms leave the shown list"
                (sort (mapcar (lambda (r) (plist-get r :room-id)) (elneo-rooms-shown)) #'string<)
                '("!emacs" "!plain"))
      (mx-check "hidden tree off the page" (string-match-p "friend" (buffer-string)) nil)
      (goto-char (point-min))
      (search-forward "Hidden")
      (forward-line 1)
      (mx-check "hidden row is there" (elneo-home--at 'elneo-home-kind) 'hidden)
      (elneo-home-ret)
      (mx-check "RET shows it again" (elneo-hidden-spaces) nil)
      (elneo-home-set-account "default")
      (mx-check "account filter" (string-match-p "plain room" (buffer-string)) nil)
      (elneo-home-set-account nil)
      (elneo-home--focus-on '("local" . "!guild"))
      (mx-check "focus shows just that space"
                (and (string-match-p "general" (buffer-string))
                     (not (string-match-p "emacs" (buffer-string)))) t)
      (elneo-home-unfocus)
      (mx-check "^ goes to the parent space" elneo-home--focus '("local" . "!discord")))))

(kill-emacs (if (> mx-failures 0) 1 0))
